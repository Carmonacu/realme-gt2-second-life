# ~/.config/gt2-power/power.conf — charge-limiter + thermal-guard (bash, se hace source)
# Copiado por install-boot-services.sh si no existe. Tras editar: sv restart charge-limiter thermal-guard

# --- Limitador de carga (enchufe inteligente vía Mosquitto + Node-RED) ---
CHARGE_ENABLED=1
CHARGE_STOP_PCT=80          # ≥ 80 % → enchufe OFF
CHARGE_RESUME_PCT=45        # ≤ 45 % → enchufe ON
CHARGE_MIN_PCT=20           # ≤ 20 % → ON siempre (emergencia, ignora temperatura)
CHARGE_TEMP_STOP_C=42       # batería ≥ 42 °C → OFF mientras carga…
CHARGE_TEMP_RESUME_C=38     # …hasta bajar a 38 °C
CHARGE_INTERVAL=60          # s entre lecturas de termux-battery-status
CHARGE_REPUBLISH_S=600      # re-envío periódico de charger/want (resync del enchufe)
CHARGE_VERIFY_GRACE=300     # s con want≠realidad («plugged») antes de avisar
CHARGE_FAILSAFE=ON          # publicado al parar el limitador (ON = seguir cargando, más seguro para un servidor)

# --- Guardián térmico (LLM) ---
THERMAL_ENABLED=1
THERMAL_HIGH_C=40           # ≥ 40 °C (THERMAL_SAMPLES lecturas seguidas) → acción
THERMAL_RESUME_C=37         # ≤ 37 °C → restaurar (histéresis)
THERMAL_CRIT_C=45           # ≥ 45 °C → parar LLM siempre
THERMAL_SAMPLES=2
THERMAL_INTERVAL=30
THERMAL_ACTION=throttle     # throttle (menos hilos, reinicia llama-server) | pause (SIGSTOP) | stop
THERMAL_THREADS=2           # hilos en throttle; si el modelo ya usa ≤ 2 (SmolLM3) se usa pause
THERMAL_AUTO_RESTART=1      # tras stop, volver a «mode llm» al enfriar (solo si el modo sigue en llm)

# --- MQTT (Mosquitto local del repo: 127.0.0.1:1883 anónimo) ---
POWER_MQTT_HOST=127.0.0.1
POWER_MQTT_PORT=1883
POWER_MQTT_PREFIX=gt2/power
#POWER_MQTT_USER=
#POWER_MQTT_PASS=

# --- Notificaciones ---
POWER_NOTIFY=1              # termux-notification (requiere Termux:API)
POWER_NOTIFY_COOLDOWN=1800  # s entre avisos repetidos
# Hook opcional (ntfy, Gotify, correo…): ejecutable que recibe <título> <mensaje> <prioridad>.
# Ejemplo ~/.config/gt2-power/notify-hook (chmod +x), si algún día montas ntfy:
#   #!/data/data/com.termux/files/usr/bin/bash
#   curl -s -H "Title: $1" -H "Priority: $([ "$3" = high ] && echo high || echo default)" -d "$2" https://ntfy.sh/<tu-topic-privado>
#POWER_NOTIFY_HOOK=$HOME/.config/gt2-power/notify-hook
POWER_PORTAL_REFRESH=1      # thermal-guard refresca status.json del portal cada ~5 min
