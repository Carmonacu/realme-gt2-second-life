#!/data/data/com.termux/files/usr/bin/bash
# Entrar a Kali NetHunter rootless (proot). Sin bind de ~/models — LLM queda en Termux nativo.

set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# En el teléfono: ~/bin/kali copiado desde el repo; common junto a llm o en ~/bin.
for d in "$HOME/bin" "$SCRIPT_DIR"; do
  if [[ -f "$d/kali-common.sh" ]]; then
    # shellcheck source=/dev/null
    source "$d/kali-common.sh"
    break
  fi
done
if [[ -z "${KALI_CHROOT:-}" ]]; then
  echo "Error: falta kali-common.sh en ~/bin" >&2
  exit 1
fi

FORCE=0
ARGS=()
for a in "$@"; do
  case "$a" in
    --force|-f) FORCE=1 ;;
    *) ARGS+=("$a") ;;
  esac
done

kali_guard_start "$FORCE" || exit 1

if ((${#ARGS[@]})); then
  kali_nh "${ARGS[@]}"
else
  kali_nh
fi
